Bootstrap: docker
From: nvidia/cuda:12.9.1-cudnn-devel-ubuntu24.04

%labels
    Description Container for fine-tuning emotion2vec+ on Japanese emotional speech
    Maintainer kobayashi.sumiharu.r4

%environment
    export LC_ALL=C.UTF-8
    export PYTHONUNBUFFERED=1
    export HF_HUB_OFFLINE=1
    export TOKENIZERS_PARALLELISM=false
    export PYTHONPATH=/workspace/emotion2vec/finetune:$PYTHONPATH

%post
    # Root-mapped namespace (no /etc/subuid entry) cannot run apt's
    # _apt sandbox user (setgroups EPERM), so disable the apt sandbox.
    echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/99-no-sandbox
    # ubuntu24.04 ships Python 3.12 (python3.11 is not in the noble archive),
    # and torch 2.15.0+cu132 provides cp312 wheels, so use 3.12.
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv libsndfile1 ca-certificates
    python3.12 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip
    /opt/venv/bin/pip install --no-cache-dir \
        "torch==2.15.0" "torchaudio==2.11.1" \
        --index-url https://download.pytorch.org/whl/cu132
    /opt/venv/bin/pip install --no-cache-dir \
        "funasr==1.4.24" \
        "soundfile" \
        "numpy" \
        "omegaconf" \
        "hydra-core" \
        "pyyaml" \
        "tqdm" \
        "tensorboard"
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    # Default entry: fine-tune with a config file, e.g.
    #   apptainer run --nv e2v-ft.sif finetune/config/base.yaml
    exec /opt/venv/bin/python /workspace/emotion2vec/finetune/train.py --config "$@"
